#!/bin/sh
#
# Gradle wrapper bootstrap for the DSA Visual Android module.
#
# Standard usage: ./gradlew assembleDebug
#
# This script launches org.gradle.wrapper.GradleWrapperMain. The wrapper jar
# (gradle/wrapper/gradle-wrapper.jar) and this script are normally generated by
# `gradle wrapper`. If you cloned the repo and the jar is missing, run
# `gradle wrapper --gradle-version 8.9` once (with a local Gradle install) or
# simply open the project in Android Studio, which materializes it automatically.
#
APP_HOME=$( cd "${APP_HOME:-$(dirname "$0")}" >/dev/null 2>&1 && pwd )
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$JAR" ]; then
  echo "gradle-wrapper.jar not found at $JAR" 1>&2
  echo "Run: gradle wrapper --gradle-version 8.9   (needs a local Gradle install)" 1>&2
  echo "Or open this project in Android Studio, which will set up the wrapper for you." 1>&2
  exit 1
fi
exec java -classpath "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
